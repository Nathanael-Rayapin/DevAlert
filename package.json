{
  "name": "@nathanael974/api-health-monitor",
  "version": "1.0.0",
  "description": "Monitor API health status with customizable checks - Powered by Statuspage.io",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "api-monitor": "./bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:bun": "bun build --config tsconfig.bun.json",
    "dev": "cross-env NODE_ENV=development tsx src/cli/commands.ts",
    "dev:bun": "bun --watch src/server/index.ts",
    "dev:init": "cross-env NODE_ENV=development tsx src/cli/commands.ts init",
    "dev:start": "cross-env NODE_ENV=development tsx src/cli/commands.ts start",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "api",
    "monitoring",
    "health-check",
    "statuspage",
    "uptime",
    "cli",
    "status",
    "availability"
  ],
  "author": "Nathanaël Rayapin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nathanael-Rayapin/DevAlert"
  },
  "bugs": {
    "url": "https://github.com/ton-username/api-health-monitor/issues"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "cross-env": "^10.1.0",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "croner": "^10.0.1",
    "ora": "^9.3.0"
  }
}
